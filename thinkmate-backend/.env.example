# --- App ---
APP_NAME=ThinkMate AI Backend
APP_ENV=development
DEBUG=true
GUIDANCE_THRESHOLD=3

# --- PostgreSQL ---
POSTGRES_USER=thinkmate
POSTGRES_PASSWORD=thinkmate_pass
POSTGRES_DB=thinkmate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://thinkmate:thinkmate_pass@postgres:5432/thinkmate_db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_COLLECTION_NAME=thinkmate_documents

# --- Ollama (LLM runtime) ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1
LLM_PROVIDER=ollama          # ollama | huggingface (future)
LLM_TIMEOUT_SECONDS=60

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Uploads ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
